+// Variação percentual entre o último preço registrado e o anterior (positivo = subiu, negativo = caiu).
+function priceTrend(item: Item, stats: ItemStats | null): number | null {
+  if (!stats || stats.entries.length < 2) return null;
+  const get = (e: any) => (item.type === "bulk" ? e.pricePerUnit ?? 0 : e.pricePerPkgAfterDiscount ?? e.pricePerPkg ?? 0);
+  const prev = get(stats.entries[stats.entries.length - 2]);
+  const last = get(stats.entries[stats.entries.length - 1]);
+  if (!prev) return null;
+  return (last - prev) / prev;
+}
